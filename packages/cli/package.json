{
  "name": "provisionless",
  "version": "0.0.0",
  "description": "Deploy Provisionless to AWS with a single command.",
  "license": "AGPL-3.0",
  "type": "module",
  "bin": {
    "provisionless": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davematias/provisionless.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "3.1135.0",
    "@aws-sdk/client-apigatewayv2": "3.1135.0",
    "@aws-sdk/client-cloudfront": "3.1135.0",
    "@aws-sdk/client-dynamodb": "3.1135.0",
    "@aws-sdk/client-iam": "3.1135.0",
    "@aws-sdk/client-lambda": "3.1135.0",
    "@aws-sdk/client-route-53": "3.1135.0",
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/client-sesv2": "3.1135.0",
    "@aws-sdk/client-sqs": "3.1135.0",
    "@aws-sdk/client-sts": "3.1135.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@aws-sdk/lib-storage": "3.1135.0",
    "@provisionless/core": "*",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "26.6.1"
  }
}
