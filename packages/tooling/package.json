{
  "name": "@provisionless/tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tooling for CI checks, such as the dependency audit.",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit": "node --experimental-strip-types src/audit-dependencies.ts",
    "sast:gate": "node --experimental-strip-types src/security-sarif.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.1"
  }
}
