{
  "name": "@provisionless/api",
  "version": "0.0.0",
  "private": true,
  "description": "Provisionless API service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "default": "./dist/lambda.js"
    }
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "openapi:generate": "node --experimental-strip-types src/openapi/generate.ts",
    "openapi:check": "node --experimental-strip-types src/openapi/generate.ts --check",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1135.0",
    "@provisionless/core": "*",
    "hono": "4.13.13",
    "hono-openapi": "^1.5.0",
    "jose": "6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@aws-sdk/client-dynamodb": "3.1135.0",
    "@aws-sdk/lib-dynamodb": "3.1135.0",
    "@hono/node-server": "2.1.1",
    "@types/node": "26.6.1",
    "dynalite": "4.0.0"
  }
}
