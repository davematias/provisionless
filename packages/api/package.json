{
  "name": "@provisionless/api",
  "version": "0.0.0",
  "private": true,
  "description": "Provisionless API service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "default": "./dist/lambda.js"
    }
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1135.0",
    "@aws-sdk/lib-dynamodb": "3.1135.0",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@types/node": "26.6.1"
  }
}
