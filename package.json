{
  "name": "provisionless-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A serverless, headless CMS.",
  "license": "AGPL-3.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "audit": "npm run audit --workspace=@provisionless/tooling",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "turbo run lint typecheck test && npm run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
