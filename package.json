{
  "name": "provisionless-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A serverless, headless CMS.",
  "license": "AGPL-3.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "turbo run lint typecheck test && npm run format:check"
  },
  "devDependencies": {
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
