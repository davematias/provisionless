{
  "name": "provisionless",
  "version": "0.0.0",
  "private": true,
  "description": "A serverless, headless CMS.",
  "license": "AGPL-3.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "turbo run lint typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
